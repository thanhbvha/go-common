# Shared local configuration for the server, client, and load generator.
SERVER_STACK=nethttp
SERVER_BROKER=nats
SERVER_ADDR=:8080
SERVER_REDIS=127.0.0.1:6379
SERVER_NATS=nats://127.0.0.1:4222
SERVER_TENANT=demo
CLIENT_TOKEN=local-demo-token
ADMIN_TOKEN=local-admin-token
CLIENT_URL=ws://127.0.0.1:8080/ws
CLIENT_USER=alice
CLIENT_TENANT=demo
CLIENT_ACCOUNT=admin
CLIENT_MODE=script
CLIENT_ROOM=demo:lobby
CLIENT_MESSAGE=hello-from-dotenv
CLIENT_TARGET_USER=alice
CLIENT_PROBE=true
LOADTEST_TARGET=ws://127.0.0.1:8080/ws
LOADTEST_CONNECTIONS=10
LOADTEST_MESSAGES=10
LOADTEST_HOLD=0s
LOADTEST_SLOW_READERS=0
LOADTEST_EVENT=system.ping
LOADTEST_SCENARIO=message
LOADTEST_RECONNECTS=3
LOADTEST_CHURN_DELAY=100ms
LOADTEST_OUTPUT=
